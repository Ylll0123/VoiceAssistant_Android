    <string name="skill_title_time">现在几点</string>
    <string name="skill_desc_time">报出当前的时分</string>
    <string name="skill_title_date">今天几号</string>
    <string name="skill_desc_date">日期、星期，也支持昨天 / 明天 / 后天</string>
    <string name="skill_title_weekday_calc">日期推算</string>
    <string name="skill_desc_weekday_calc">算下周几是几号、距离某个日子还有几天</string>
    <string name="skill_title_timezone">世界时间</string>
    <string name="skill_desc_timezone">纽约、伦敦、东京等城市现在几点</string>
    <string name="skill_title_arithmetic">算数</string>
    <string name="skill_desc_arithmetic">四则运算、括号、百分号，直接说算式就行</string>
    <string name="skill_title_calc_continue">接着算</string>
    <string name="skill_desc_calc_continue">在上一次结果上继续加减乘除</string>
    <string name="skill_title_unit_convert">单位换算</string>
    <string name="skill_desc_unit_convert">公里/英里、摄氏度/华氏度、斤/千克等</string>
    <string name="skill_title_age">年龄计算</string>
    <string name="skill_desc_age">说出出生年份，算今年多大</string>
    <string name="skill_title_random">做个决定</string>
    <string name="skill_desc_random">抛硬币、掷骰子、随机数、二选一</string>
    <string name="skill_title_support">能力清单</string>
    <string name="skill_desc_support">看看助手现在会做什么</string>
    <string name="skill_title_reminder">定时提醒</string>
    <string name="skill_desc_reminder">说到点就弹通知，重启手机也不会丢；也支持查看和删除清单</string>
    <string name="skill_title_timer">计时器</string>
    <string name="skill_desc_timer">倒计时结束弹通知，说「取消计时」可以中途停掉</string>
    <string name="skill_title_torch">手电筒</string>
    <string name="skill_desc_torch">直接开关手机的闪光灯</string>
    <string name="skill_title_battery">剩余电量</string>
    <string name="skill_desc_battery">报出电量百分比，顺便说一句在不在充电</string>
    <string name="skill_title_open_app">打开应用</string>
    <string name="skill_desc_open_app">按名字拉起微信、相机、设置这些常用应用</string>
    <string name="skill_title_echo">复读朗读</string>
    <string name="skill_desc_echo">让它照着念：说「说出……」「帮我朗读……」，后面的字原样说出来</string>
    <string name="skill_title_guess">猜数字游戏</string>
    <string name="skill_desc_guess">1 到 100 之间猜数，助手会提示大小，可以连猜多轮</string>
    <string name="skill_title_joke">讲个笑话</string>
    <string name="skill_desc_joke">本地笑话库，随机一条</string>
    <string name="skill_title_quote">来句名言</string>
    <string name="skill_desc_quote">随机一句名言或诗句</string>
    <string name="skill_title_weather">天气与气温</string>
    <string name="skill_desc_weather">联网给出实时气温体感和当日高低（没网就用常年气候数据，照样有答案）</string>
    <string name="skill_title_outing">出行建议</string>
    <string name="skill_desc_outing">按月份和城市给出出行、穿衣、带伞这类能照做的提醒</string>
    <string name="skill_title_translate">单词翻译</string>
    <string name="skill_desc_translate">内置中英基础词典双向查询，中翻英、英翻中都能用</string>
    <string name="skill_title_knowledge">常识问答</string>
    <string name="skill_desc_knowledge">天气原理、健康、学习、生活窍门、安全急救等几百条有标准答案的问题</string>
    <string name="skill_title_decide">分析与决策</string>
    <string name="skill_desc_decide">拿不准的选择、找不到头绪的问题，给一套「目的—代价—退路」的判断顺序</string>
    <string name="skill_title_online">联网查资料</string>
    <string name="skill_desc_online">本地答不上来时上网搜索，把查到的摘要连同来源一起说给你（没网自动回落）</string>
    <string name="skill_title_follow_up">多轮追问</string>
    <string name="skill_desc_follow_up">3 分钟内可以用「那后天呢」「再来一个」这种省略说法接着聊</string>
    <string name="features_examples_note">示例说法是中文：离线引擎目前只认中文指令。</string>

