<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        固定浅色主题，不用 DayNight。
        本应用的配色（背景 / 气泡 / 文字）全部是写死的浅色值，
        一旦跟随系统深色模式，就会出现「手机深色模式下界面和电脑模拟器完全不一样」：
        开关、涟漪、状态栏图标、输入框提示文字都会跟着系统变。
        这里统一钉死，保证不同设备显示一致。
    -->
    <style name="Base.Theme.VoiceAssistant" parent="Theme.Material3.Light.NoActionBar">
        <!-- 主色，让 Material 控件（开关、涟漪）与界面配色一致 -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/chip_bg</item>
        <item name="colorOnPrimaryContainer">@color/brand_primary_dark</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/input_bg</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="android:colorBackground">@color/bg_app</item>

        <!-- 窗口底色，避免启动瞬间黑屏 / 白屏与界面不一致 -->
        <item name="android:windowBackground">@color/bg_app</item>

        <!-- 状态栏 / 导航栏：透明 + 深色图标，与浅色界面配套 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- 关掉强制深色（部分国产 ROM 会强行反色） -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Theme.VoiceAssistant" parent="Base.Theme.VoiceAssistant" />

    <!--
        弹窗：白底、黑字、没有 M3 默认的紫灰色调。

        为什么单独写一层：Material3 的对话框底色取的是 colorSurfaceContainerHigh，
        本应用的主题没定义这个值，Material 就按主色（蓝）现算一个「色调化」的颜色，
        在真机上看着发灰发紫，和整个浅色界面不搭。这里把它连同几个相关的面都钉成纯白，
        按钮也改成黑字，整体就是一张干净的白纸。
    -->
    <style name="ThemeOverlay.VoiceAssistant.Dialog"
        parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorSurfaceContainerLow">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <!-- 按钮、单选圈都用黑，别掺品牌蓝和紫色 -->
        <item name="colorPrimary">@color/text_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/text_primary</item>
        <item name="colorControlActivated">@color/text_primary</item>
    </style>
</resources>
