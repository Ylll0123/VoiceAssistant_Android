<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 语音输入需要录音权限；系统语音识别走网络时需要联网权限 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 联网搜索：天气 / 百科 / 必应摘要都需要 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        提醒 / 计时：到点弹通知，重启后把闹钟重排。
        精确闹钟用 USE_EXACT_ALARM 而不是 SCHEDULE_EXACT_ALARM：
        后者在 Android 14+ 对新装应用默认拒绝，得引导用户去系统设置里手动开，
        提醒就会变成「差不多那个点」——对闹钟类应用不可接受。
        USE_EXACT_ALARM 安装即生效，代价是应用商店要求它只用于闹钟/日历类应用
        （本项目是课程作业，不上架）。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 手电筒开关 -->
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />

    <!-- Android 11+ 需要声明可见性，否则找不到系统的识别 / 播报服务 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- 「打开微信 / 拉起相机」要能解析到目标应用 -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoiceAssistant">
        <activity
            android:name=".ui.VoiceAssistantActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 闹钟到点：弹通知；通知上的「稍后」「知道了」也回到这里 -->
        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <!-- 开机 / 覆盖安装后把还没到点的提醒重排（AlarmManager 的登记会丢） -->
        <receiver
            android:name=".reminder.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
