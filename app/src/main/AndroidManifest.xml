<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 语音输入需要录音权限；系统语音识别走网络时需要联网权限 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 联网搜索：天气 / 百科 / 必应摘要都需要 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        提醒 / 计时：到点弹通知，重启后把闹钟重排。
        精确闹钟用 USE_EXACT_ALARM 而不是 SCHEDULE_EXACT_ALARM：
        后者在 Android 14+ 对新装应用默认拒绝，得引导用户去系统设置里手动开，
        提醒就会变成「差不多那个点」——对闹钟类应用不可接受。
        USE_EXACT_ALARM 安装即生效，代价是应用商店要求它只用于闹钟/日历类应用
        （本项目是课程作业，不上架）。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 手电筒开关 -->
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />

    <!--
        闹钟：系统时钟应用的 SET_ALARM / SET_TIMER 入口挂着这个权限
        （`com.android.alarm.permission.SET_ALARM`，普通权限、装上就有）。
        不声明的话 `resolveActivity` 直接返回 null，看得到时钟应用也叫不起来——
        表现就是「明明有时钟，助手说设不了闹钟」。
    -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- 改系统亮度：属于「特殊权限」，要在设置页里由用户手动授予 -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!--
        「打开任意应用」的关键：Android 11 起应用默认看不到别人装了什么，
        不加这条，PackageManager 只会返回系统白名单里的几个包，
        「打开原神」「打开学习通」就永远查不到。
        应用商店会问用途（辅助语音操作），侧载自用无影响。
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- 蓝牙开关状态查询 / 连接（Android 12+ 必需） -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:ignore="MissingPermission" />

    <!--
        打电话：读通讯录是为了把「打给妈妈」翻成号码，直接拨号是为了不用再点一下。
        两个都是危险权限，在**第一次真要用时**才申请（见 VoiceAssistantActivity）。
        拒绝也不影响用：没有 CALL_PHONE 就走 ACTION_DIAL（拨号盘，零权限），
        没有 READ_CONTACTS 就提示用户直接说号码。
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- 没有拨号 / 地图应用的设备（平板、车机）也别装不上 -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- Android 11+ 需要声明可见性，否则找不到系统的识别 / 播报服务 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- 「打开微信 / 拉起相机」要能解析到目标应用 -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!--
            包名可见性：不加这两条，Android 11+ 上
            getLaunchIntentForPackage / getPackageInfo 会直接返回 null，
            表现就是「手机里明明装了微信，助手说没装」。
        -->
        <package android:name="com.tencent.mm" />
        <package android:name="com.tencent.mobileqq" />

        <!-- 闹钟 / 计时直接交给系统时钟应用，Android 11+ 要先声明才解析得到 -->
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <!-- 「播放音乐」要先看本机有哪些音乐应用 -->
        <intent>
            <action android:name="android.intent.action.MUSIC_PLAYER" />
        </intent>
        <!--
            拨号与地图：Android 11+ 不声明就 resolveActivity 返回 null，
            表现是「明明有电话/地图应用，助手却说没有」。
        -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoiceAssistant">

        <!-- 登录 / 注册：本地账号，进门后才进主界面 -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.VoiceAssistantActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 闹钟到点：弹通知；通知上的「稍后」「知道了」也回到这里 -->
        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <!--
            无障碍服务：发消息自动化的那只手。
            必须在系统设置里由用户手动勾选，应用无法自己打开。
            用途说明写在 @string/accessibility_description，上架审核会看这一段。
        -->
        <service
            android:name=".im.ImAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 开机 / 覆盖安装后把还没到点的提醒重排（AlarmManager 的登记会丢） -->
        <receiver
            android:name=".reminder.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
